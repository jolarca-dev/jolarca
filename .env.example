# =============================================================================
# jol-m-marketplace — environment template (DEVELOPMENT)
# Copy to .env and fill in. NEVER commit real values. CI blocks secrets.
# PRODUCTION deploys use a separate template: see .env.prod.example
# (docker-compose.prod.yml, scripts/deploy.sh).
# =============================================================================

# --- Runtime ----------------------------------------------------------------
# One of: dev | test | production. production refuses insecure fallbacks.
DJANGO_ENV=dev
DJANGO_DEBUG=1
DJANGO_SETTINGS_MODULE=project.settings.dev
# Comma-separated. production MUST set this explicitly.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed by CORS.
DJANGO_CORS_ORIGINS=http://localhost:3000
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_python_c_secrets_token_urlsafe
TZ=UTC

# --- GDPR / data-protection controls -----------------------------------------
# Fail-closed kill switch: when 1, ALL mutating API traffic returns 503.
# Flip during an unresolved incident / suspected breach (see runbooks).
GDPR_PROCESSING_HALTED=0
# Enforce recorded consent before personalized processing.
GDPR_CONSENT_REQUIRED=1
# Days to complete an Art. 17 erasure request (SLA monitored by compliance_app).
GDPR_ERASURE_SLA_DAYS=30
# Retention for financial/tax records before anonymization (LT/LV/EE tax law).
RETENTION_FINANCIAL_YEARS=7

# --- PostgreSQL (PostGIS + pgcrypto + pgvector + citext) --------------------
# Host-mapped port of the dev-compose PostGIS container (5433). The host
# PostgreSQL keeps 5432 for the JOL Church platform (jol-hub). Inside the
# compose network, services are pinned back to 5432 (docker-compose.dev.yml).
POSTGRES_DB=jol_marketplace
POSTGRES_USER=jol_marketplace
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5433
POSTGRES_PORT=5433
DATABASE_URL=postgres://jol_marketplace:CHANGE_ME@localhost:5433/jol_marketplace

# --- Redis (Celery broker + cache + rate limiting) ---------------------------
# Host-mapped port of the dev-compose Redis (6380); host Redis keeps 6379.
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1

# --- Object storage (media; S3-compatible: MinIO dev / S3 prod) --------------
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_BUCKET=jol-media
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# --- Payments: payments_app is the ONLY Stripe integration boundary ----------
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_CONNECT_CLIENT_ID=
# Empty disables Stripe Tax; tax_app falls back to VatRateSnapshot tables.
STRIPE_TAX_ENABLED=0

# --- Field-level encryption (core/encryption.py). Fernet key. ----------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ROTATION: keep comma-separated list, newest first. Never delete old keys
# before re-encrypting all live ciphertext (see runbooks/).
FIELD_ENCRYPTION_KEY=CHANGE_ME

# --- AI providers (ai_service_app). Local-first; commercial = fallback only --
AI_DEFAULT_PROVIDER=selfhosted
AI_SELFHOSTED_BASE_URL=http://localhost:8001/v1
AI_SELFHOSTED_API_KEY=
AI_SELFHOSTED_MODEL=qwen3
DEEPL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# PII guardrail: hard requirement, no bypass flag exists by design.
AI_PII_FILTER_ENABLED=1

# --- CRM sync (bitrix24_integration_app). Kill switch: failures never block --
BITRIX24_ENABLED=0
BITRIX24_WEBHOOK_URL=

# --- Carriers (shipping_app) --------------------------------------------------
DPD_API_BASE_URL=https://apis.dpd.com
DPD_API_KEY=CHANGE_ME
OMNIVA_API_BASE_URL=https://www.omniva.lt/partner-api
OMNIVA_API_USER=CHANGE_ME
OMNIVA_API_KEY=CHANGE_ME

# --- Observability (optional but recommended in production) -------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Email (dev uses Mailpit via SMTP) ----------------------------------------
EMAIL_HOST=localhost
EMAIL_PORT=1025

# --- Dev-stack host ports (docker-compose.dev.yml) ---------------------------
# Offset from defaults so jol-hub (8000) and the self-hosted AI server
# (AI_SELFHOSTED_BASE_URL, 8001) can run concurrently on this machine.
BACKEND_PORT=8010
FRONTEND_PORT=3000
