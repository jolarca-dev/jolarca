# JOL Marketplace frontend + production compose — REQUIRED variables.
# Copy to .env at the repo root (compose) / frontend/.env (local dev).
# NEVER commit real values; CI rejects files that look like secrets.

# --- Next.js app -------------------------------------------------------------
# Browser-reachable origin of the Django API (baked into the client bundle).
NEXT_PUBLIC_API_URL=http://localhost:8010
# Server-side (RSC) base URL. Inside containers the browser-facing URL is
# unreachable; point this at the compose-internal backend address. Leave
# unset for bare host development (falls back to NEXT_PUBLIC_API_URL).
INTERNAL_API_URL=
# Stripe PUBLISHABLE key only (pk_test_/pk_live_). Never a secret key —
# card data stays inside Stripe's Payment Element iframe (SAQ-A). Empty →
# the payment step renders a "payments being prepared" notice.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Self-hosted Plausible (analytics). Loaded ONLY after explicit analytics
# consent (ConsentGate). Both empty → analytics disabled by configuration.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_API=
# Build-time CSP nonce placeholder. Leave empty unless you understand the
# trade-off: true per-request nonces require middleware injection.
CSP_NONCE=

# --- docker-compose.yml (production topology) --------------------------------
HTTP_PORT=80
# Nginx upstream for the Django API (scheme://host:port).
BACKEND_UPSTREAM=http://host.docker.internal:8000

# Data tier (dev parity services).
POSTGRES_DB=jol_marketplace
POSTGRES_USER=jol
POSTGRES_PASSWORD=change-me-strong-password

# --- Runtime (container env; defaults shown) ---------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# --- E2E ----------------------------------------------------------------------
# Base URL for Playwright when not using the built-in dev server.
E2E_BASE_URL=http://localhost:3000
