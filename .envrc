# jolarca — auto-activate the one authoritative virtualenv on cd (direnv).
#
# Host prerequisite this file cannot install: the direnv shell hook, once per
# machine — `eval "$(direnv hook bash)"` in ~/.bashrc — plus `direnv allow` per
# checkout. A .envrc in an unhooked shell is inert, and an inert file that reads
# like a control is §8 G24's failure mode, so §8 G37 states the prerequisite
# rather than claiming this file activates anything on its own.
#
# Everything is resolved relative to this file, never hard-coded: direnv evaluates
# .envrc with the containing directory as cwd, and this checkout's absolute path
# has already moved once (the 2026-08-31 infrastructure rename, incident
# JOL-RENAME-20260831-01), which is exactly what strands literal venv paths — the
# same class that left stale shebangs in .venv/bin and a dead module SDK reference.

if [ ! -f .venv/bin/activate ]; then
  log_error "jolarca: no .venv/bin/activate in $PWD — run 'make bootstrap' (CONTRIBUTING.md → Development setup)"
else
  VIRTUAL_ENV="$(expand_path .venv)"
  export VIRTUAL_ENV
  PATH_add .venv/bin
  # virtualenv's own bin/activate sets VIRTUAL_ENV_PROMPT; direnv does not, and
  # ~/.bashrc's __env_integrity renders the "(.venv)" prompt label from it. Set it
  # explicitly instead of relying on the basename fallback: the label is a claim
  # about which environment this shell resolves tools from.
  export VIRTUAL_ENV_PROMPT=".venv"
  # Prove it, the same rule as scripts/activate.sh (§8 G37): a tool that still
  # resolves outside the venv means something repended PATH after direnv ran.
  __jolarca_python=$(command -v python || true)
  case "$__jolarca_python" in
  "$VIRTUAL_ENV"/bin/*) ;;
  *)
    log_warning "jolarca: python resolves at ${__jolarca_python:-<nothing>} , outside $VIRTUAL_ENV — do not trust local lint/test output"
    ;;
  esac
  unset __jolarca_python
fi
