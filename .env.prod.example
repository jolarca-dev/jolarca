# =============================================================================
# JOL Marketplace — PRODUCTION environment template (docker-compose.prod.yml)
# Copy to .env.prod and fill in. NEVER commit real values (git-ignored).
# Descriptions inline; no default secrets anywhere in this file.
# =============================================================================

# --- Identity / ingress --------------------------------------------------------
# Public domain served by nginx (TLS cert must match).
DOMAIN=marketplace.gyvenimo-kelias.lt
# Host ports (change only if 80/443 are taken on the VM).
HTTP_PORT=80
HTTPS_PORT=443
# Django API as reachable FROM the nginx container, scheme included.
# Containerized API tier (this compose file): http://backend:8000
BACKEND_UPSTREAM=http://backend:8000

# --- Image tag (set by scripts/deploy.sh; safe to leave) -----------------------
IMAGE_TAG=latest

# --- PostgreSQL (consumed by postgres service + Django) ------------------------
POSTGRES_DB=jolarca
POSTGRES_USER=jolarca
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# Django-side connection string (compose network name = service name).
DATABASE_URL=postgres://jolarca:CHANGE_ME@postgres:5432/jolarca

# --- Redis ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Browser-reachable origins (baked into the frontend bundle at BUILD) -------
NEXT_PUBLIC_API_URL=https://marketplace.gyvenimo-kelias.lt/api
NEXT_PUBLIC_SITE_URL=https://marketplace.gyvenimo-kelias.lt
# Self-hosted media host (MinIO/S3 public endpoint) for next/image.
NEXT_PUBLIC_MEDIA_HOSTNAME=

# --- Django backend (fail-closed: service refuses to boot without these) --------
# Generate ≥50 chars: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
# Comma-separated; loopback values are rejected in production.
DJANGO_ALLOWED_HOSTS=marketplace.gyvenimo-kelias.lt
# Same-origin frontend → CORS stays tight to the public origin only.
DJANGO_CORS_ORIGINS=https://marketplace.gyvenimo-kelias.lt
# Fernet key for PII-at-rest: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
DJANGO_DEBUG=false
DJANGO_ENV=production
TZ=Europe/Vilnius

# --- GDPR / retention -----------------------------------------------------------
GDPR_CONSENT_REQUIRED=true
GDPR_PROCESSING_HALTED=false
GDPR_ERASURE_SLA_DAYS=30
RETENTION_FINANCIAL_YEARS=7

# --- Stripe (SAQ-A: publishable key in frontend env; secret ONLY backend-side) --
# Use TEST keys until go-live; live keys switch real money flows.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_TAX_ENABLED=false

# --- AI translation / enrichment (backend consumers) ----------------------------
DEEPL_API_KEY=
OPENAI_API_KEY=
# Self-hosted inference endpoint (preferred — no third-party data leaves the VM).
AI_SELFHOSTED_BASE_URL=
AI_SELFHOSTED_API_KEY=
AI_DEFAULT_PROVIDER=selfhosted
AI_PII_FILTER_ENABLED=true

# --- Object storage (media + KYC documents) -------------------------------------
AWS_S3_ENDPOINT_URL=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- SMTP (transactional email: orders, 2FA, erasure confirmations) -------------
EMAIL_HOST=
EMAIL_PORT=587
# Credentials live backend-side; never expose to the frontend bundle.

# --- Observability ---------------------------------------------------------------
# Optional: client vitals collector + OTLP endpoint (see src/lib/otel.ts).
NEXT_PUBLIC_OTEL_ENDPOINT=
SENTRY_DSN=
# Monitoring alerts (scripts/monitoring.sh).
MONITOR_WEBHOOK_URL=
MONITOR_EMAIL=

# --- Backups (scripts/backup.sh) --------------------------------------------------
# Leave empty for local-only rotation; set for off-VM copies.
BACKUP_S3_BUCKET=
BACKUP_ROOT=/var/backups/jolarca
